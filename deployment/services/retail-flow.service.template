[Unit]
Description=Retail Flow Gunicorn Service
After=network.target

[Service]
User={{USER}}
Group={{GROUP}}

WorkingDirectory={{WORKING_DIRECTORY_PATH}}

ExecStart={{VIRTUAL_ENVIRONMENT_PATH}}/bin/gunicorn \
    retailflow.wsgi:application \
    --bind 0.0.0.0:{{PORT}} \
    --workers {{WORKERS}}

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target