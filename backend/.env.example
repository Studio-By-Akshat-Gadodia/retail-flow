# ──────────────────────────────────────────────────────────
# Retail Flow — Django backend environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ──────────────────────────────────────────────────────────

# ── Django core ────────────────────────────────────────────
# Generate a strong key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-string

DEBUG=True

# Comma-separated list of allowed hostnames (no spaces)
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ───────────────────────────────────────────────
# SQLite (default for local dev — leave DB_ENGINE unset or set as below)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# PostgreSQL (uncomment and fill for staging / production)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=finance_manager
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# ── CORS ───────────────────────────────────────────────────
# Comma-separated origins allowed to call the API from a browser.
# The Vite dev server origin must be listed here during development.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── JWT ────────────────────────────────────────────────────
# Token lifetimes are configured in settings/rest_framework.py.
# No extra env vars needed unless you override them.

# ── Email ────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=30
DEFAULT_FROM_EMAIL='Finance Manager <your-email@gmail.com>'
SERVER_EMAIL=your-email@gmail.com
ADMIN_NAME=Akshat
ADMIN_EMAIL=your-email@gmail.com

# ── Static/Media ────────────────────────────────────────────────────
STATIC_ROOT=/home/auriga/Projects/finance-manager/backend/staticfiles
MEDIA_ROOT=/home/auriga/Projects/finance-manager/backend/mediafiles

# ── Frontend URL (used in email links) ───────────────────────────────
# In dev: http://localhost:5173  |  In prod: your public domain
FRONTEND_URL=http://localhost:5173

# ── Site URL (used in sitemap + robots.txt canonical URLs) ─────────────
SITE_URL=https://yourdomain.com