# ──────────────────────────────────────────────────────────
# RetailFlow — Django backend environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ──────────────────────────────────────────────────────────

# ── Django core ────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ───────────────────────────────────────────────
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# PostgreSQL (uncomment for staging / production)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=retailflow
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# ── CORS ───────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Frontend URL (used in email links) ─────────────────────
FRONTEND_URL=http://localhost:5173

# ── Email (SMTP) ───────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=30
DEFAULT_FROM_EMAIL=RetailFlow <your-email@gmail.com>
SERVER_EMAIL=your-email@gmail.com
ADMIN_NAME=Admin
ADMIN_EMAIL=your-email@gmail.com

# ── Google OAuth2 (Sign-In) ───────────────────────────────
GOOGLE_CLIENT_ID=

# ── Celery / Redis ─────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── WhatsApp — Meta Cloud API ─────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Push — Firebase FCM (requires: pip install firebase-admin) ─
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
DB_LOG_LEVEL=WARNING

# ── Static/Media ───────────────────────────────────────────
# STATIC_ROOT=/path/to/staticfiles
# MEDIA_ROOT=/path/to/mediafiles
